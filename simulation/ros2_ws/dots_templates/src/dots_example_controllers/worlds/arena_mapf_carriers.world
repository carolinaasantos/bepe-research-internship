<sdf version='1.6'>
  <world name='default'>
    <physics name='default_physics' default='0' type='ode'>
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
      <ode> <solver> <type>quick</type> </solver> </ode>
    </physics>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>0</shadows>
    </scene>
    <gui>
      <camera name="user_camera">
        <pose>0.0 -5.0 5 0 0.8 1.5708</pose>
      </camera>
    </gui>

    <include>
      <uri>model://ground_plane</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://sun</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://arena</uri>
      <pose>0.65 -0.65 0 0 0 1.5708</pose>
    </include>

    <!--
      CARRIERS - Adicione, remova ou mova carriers aqui.

      Pose format: <pose>X Y 0 0 0 ROTACAO</pose>
        X, Y   : posicao no mapa (arena vai de -1.85 a 1.85 em ambos os eixos)
        ROTACAO: angulo em radianos (ex: 0, 1.5708=90deg, 3.1416=180deg)

      Carriers disponiveis: carrier100 ate carrier119 (20 no total)
      Cada carrier deve ter um nome unico (<name>carrierXXX</name>).

      Exemplo para adicionar um novo carrier:
        <include><uri>model://carrier110</uri><name>carrier110</name><pose>0.5 0.5 0 0 0 0</pose></include>
    -->

    <!-- Carrier 100 - posicao inicial -->
    <include><uri>model://carrier100</uri><name>carrier100</name><pose>-0.925  0.925 0 0 0 0.0</pose></include>

    <!-- Carrier 101
    <include><uri>model://carrier101</uri><name>carrier101</name><pose>-0.925  -0.4625 0 0 0 0.0</pose></include>
    -->

    <!-- Carrier 102
    <include><uri>model://carrier102</uri><name>carrier102</name><pose>-0.925 -1.3875 0 0 0 0.0</pose></include>
    -->

    <!-- Carrier 103
    <include><uri>model://carrier103</uri><name>carrier103</name><pose>-0.710  0.130 0 0 0 0.0</pose></include>
    -->

    <!-- Carrier 104
    <include><uri>model://carrier104</uri><name>carrier104</name><pose>-1.320  0.132 0 0 0 0.0</pose></include>
    -->

    <!-- Para adicionar mais carriers, descomente ou copie as linhas abaixo: -->
    <!-- <include><uri>model://carrier105</uri><name>carrier105</name><pose> 0.500  0.500 0 0 0 0.0</pose></include> -->
    <!-- <include><uri>model://carrier106</uri><name>carrier106</name><pose> 0.500 -0.500 0 0 0 0.0</pose></include> -->
    <!-- <include><uri>model://carrier107</uri><name>carrier107</name><pose>-0.500  1.000 0 0 0 0.0</pose></include> -->
    <!-- <include><uri>model://carrier108</uri><name>carrier108</name><pose>-0.500 -1.000 0 0 0 0.0</pose></include> -->
    <!-- <include><uri>model://carrier109</uri><name>carrier109</name><pose> 1.000  0.000 0 0 0 0.0</pose></include> -->
    <!-- <include><uri>model://carrier110</uri><name>carrier110</name><pose>-1.000  0.500 0 0 0 0.0</pose></include> -->

